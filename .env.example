# Database connection URL.
#
# LOCAL DEV (default — SQLite): a relative file path inside the db/ folder.
#   DATABASE_URL="file:./db/custom.db"
#
# VERCEL / PRODUCTION: SQLite does NOT work on Vercel serverless because the
# filesystem is ephemeral. Swap to a hosted DB and set this env var in your
# Vercel project settings. Recommended options for this stack:
#   - Neon (Postgres, free tier):       postgresql://user:pass@host/db?sslmode=require
#   - PlanetScale (MySQL, serverless): mysql://user:pass@host/db?sslmode=require
#   - Supabase (Postgres, free tier):  postgresql://user:pass@host/db
#   - Turso (SQLite-compatible, edge): libsql://host?token=xxx  (needs @libsql/client + prisma adapter)
#
# After setting DATABASE_URL in Vercel, also update prisma/schema.prisma's
# `datasource db` provider if you switch away from SQLite (e.g. to
# `provider = "postgresql"`).
DATABASE_URL="file:./db/custom.db"
